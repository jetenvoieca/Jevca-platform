# This is just a template — never put real values here.
# Real value goes into Netlify's own Environment Variables settings.

# Use the DIRECT (non-pooled) Neon connection string —
# the one WITHOUT "-pooler" in the hostname.
DATABASE_URL="postgresql://user:password@host/dbname?sslmode=require"

# Stripe — secret key and webhook signing secret come from the Stripe
# dashboard (test mode keys for now). Never commit real values.
STRIPE_SECRET_KEY="sk_test_..."
STRIPE_WEBHOOK_SECRET="whsec_..."
# The publishable key is safe to expose to the browser (NEXT_PUBLIC_ prefix
# required so Next.js bundles it into client code) — it's used by
# StripeCardForm to load Stripe.js.
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY="pk_test_..."

# The real deployed URL — Stripe Checkout redirects back here after a
# Payment Link is paid. Set to https://jevca.netlify.app in Netlify.
NEXT_PUBLIC_APP_URL="http://localhost:3000"
