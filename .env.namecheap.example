# This is just a template — never put real values here.
# Copy this file to .env.namecheap (already gitignored) and fill it in.
# Used only by scripts/fetch-domains.js, which runs on YOUR computer, never
# on Netlify — see that script for why.

# Your Namecheap account username (also used as the API username).
NAMECHEAP_API_USER=

# Generated in Namecheap: Profile > Tools > Namecheap API Access.
NAMECHEAP_API_KEY=

# The IP address you whitelisted in that same Namecheap screen — must
# match the IP this script actually runs from (your current home/office
# IP), or Namecheap will reject the request.
NAMECHEAP_CLIENT_IP=
