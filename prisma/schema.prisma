generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum ArtistStatus {
  ACTIVE
  PROSPECT
  ARCHIVED
}

enum SiteStatus {
  DRAFT
  LIVE
  PAUSED
  ARCHIVED
}

enum PageType {
  SECTION
  PRIVATE
}

enum ArtworkAvailability {
  AVAILABLE
  RESERVED
  SOLD
}

enum ImageStatus {
  HOPPER
  SORTED
  ARCHIVED
}

enum ImageKind {
  PHOTO
  VIDEO
}

model Artist {
  id        String       @id @default(cuid())
  name      String
  email     String?
  phone     String?
  notes     String?
  status    ArtistStatus @default(ACTIVE)
  createdAt DateTime     @default(now())
  updatedAt DateTime     @updatedAt
  sites     Site[]
}

model Site {
  id                   String     @id @default(cuid())
  name                 String
  domain               String?
  status               SiteStatus @default(DRAFT)
  multiLanguageEnabled Boolean    @default(false)
  artistId             String
  artist               Artist     @relation(fields: [artistId], references: [id])
  createdAt            DateTime   @default(now())
  updatedAt            DateTime   @updatedAt

  pages    Page[]
  artworks Artwork[]
  images   Image[]
  menus    Menu[]

  @@index([artistId])
}

model Page {
  id        String   @id @default(cuid())
  siteId    String
  site      Site     @relation(fields: [siteId], references: [id])
  type      PageType
  title     String
  slug      String
  visible   Boolean  @default(true)
  position  Int      @default(0)
  sourceTag String?

  draftBlocks Json  @default("[]")
  liveBlocks  Json?

  menuItems MenuItem[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([siteId, slug])
  @@index([siteId])
}

// A saved, named navigation arrangement. A site can have several; exactly
// one is active (used by the live site) at a time — switching which one is
// active is a single action, not a rebuild.
model Menu {
  id       String  @id @default(cuid())
  siteId   String
  site     Site    @relation(fields: [siteId], references: [id])
  name     String
  isActive Boolean @default(false)

  groups MenuGroup[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([siteId])
}

// A named cluster of menu items within one Menu (e.g. "MY GALLERIES").
// Belongs to exactly one Menu — editing one saved Menu never touches another.
model MenuGroup {
  id       String @id @default(cuid())
  menuId   String
  menu     Menu   @relation(fields: [menuId], references: [id], onDelete: Cascade)
  name     String
  position Int    @default(0)

  items MenuItem[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([menuId])
}

// One entry in a menu group. Always points at a real Page, but carries its
// own label and byline — fully independent of that Page's actual title, and
// the same Page can be featured by more than one MenuItem (different
// groups, different menus, or more than once in the same group).
model MenuItem {
  id       String    @id @default(cuid())
  groupId  String
  group    MenuGroup @relation(fields: [groupId], references: [id], onDelete: Cascade)
  pageId   String
  page     Page      @relation(fields: [pageId], references: [id])
  label    String
  byline   String?
  position Int       @default(0)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([groupId])
  @@index([pageId])
}

model Artwork {
  id     String @id @default(cuid())
  siteId String
  site   Site   @relation(fields: [siteId], references: [id])

  // Catalogue number is the record's identifier — auto-generated, shared by both facets.
  catalogueNumber String

  // --- Presentation facet: what customers see on the public site ---
  presentationTitle String
  presentationPrice Decimal?            @db.Decimal(10, 2)
  dimensions        String?
  description       String?
  medium            String?
  presentationGroup String?
  availability      ArtworkAvailability @default(AVAILABLE)
  visible           Boolean             @default(true)

  // --- Catalogue facet: the artist's private working record ---
  catalogueName  String
  year           Int?
  type           String?
  catalogueGroup String?
  size           String?
  location       String?
  edition        String?
  availableQty   Int?
  priceUnframed  Decimal? @db.Decimal(10, 2)
  priceFramed    Decimal? @db.Decimal(10, 2)
  studioNotes    String?

  images Image[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([siteId, catalogueNumber])
  @@index([siteId])
}

model Image {
  id        String      @id @default(cuid())
  siteId    String
  site      Site        @relation(fields: [siteId], references: [id])
  key       String
  url       String
  kind      ImageKind   @default(PHOTO)
  mimeType  String
  caption   String?
  altText   String?
  tags      String[]    @default([])
  status    ImageStatus @default(SORTED)
  source    String?
  artworkId String?
  artwork   Artwork?    @relation(fields: [artworkId], references: [id])

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([siteId])
  @@index([artworkId])
}
