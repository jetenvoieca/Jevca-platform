generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum ArtistStatus {
  ACTIVE
  PROSPECT
  ARCHIVED
}

enum SiteStatus {
  DRAFT
  LIVE
  PAUSED
  ARCHIVED
}

enum PageType {
  SECTION
  PRIVATE
}

enum ArtworkAvailability {
  AVAILABLE
  RESERVED
  SOLD
}

enum ImageStatus {
  HOPPER
  SORTED
  ARCHIVED
}

enum ImageKind {
  PHOTO
  VIDEO
}

model Artist {
  id        String       @id @default(cuid())
  name      String
  email     String?
  phone     String?
  notes     String?
  status    ArtistStatus @default(ACTIVE)
  createdAt DateTime     @default(now())
  updatedAt DateTime     @updatedAt
  sites     Site[]
}

model Site {
  id                   String     @id @default(cuid())
  name                 String
  domain               String?
  status               SiteStatus @default(DRAFT)
  multiLanguageEnabled Boolean    @default(false)
  artistId             String
  artist               Artist     @relation(fields: [artistId], references: [id])
  createdAt            DateTime   @default(now())
  updatedAt            DateTime   @updatedAt

  pages    Page[]
  artworks Artwork[]
  images   Image[]

  @@index([artistId])
}

model Page {
  id        String   @id @default(cuid())
  siteId    String
  site      Site     @relation(fields: [siteId], references: [id])
  type      PageType
  title     String
  slug      String
  visible   Boolean  @default(true)
  position  Int      @default(0)
  sourceTag String?

  draftBlocks Json  @default("[]")
  liveBlocks  Json?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([siteId, slug])
  @@index([siteId])
}

model Artwork {
  id     String @id @default(cuid())
  siteId String
  site   Site   @relation(fields: [siteId], references: [id])

  // Catalogue number is the record's identifier — auto-generated, shared by both facets.
  catalogueNumber String

  // --- Presentation facet: what customers see on the public site ---
  presentationTitle String
  presentationPrice Decimal?            @db.Decimal(10, 2)
  dimensions        String?
  description       String?
  medium            String?
  presentationGroup String?
  availability      ArtworkAvailability @default(AVAILABLE)
  visible           Boolean             @default(true)

  // --- Catalogue facet: the artist's private working record ---
  catalogueName  String
  year           Int?
  type           String?
  catalogueGroup String?
  size           String?
  location       String?
  edition        String?
  availableQty   Int?
  priceUnframed  Decimal? @db.Decimal(10, 2)
  priceFramed    Decimal? @db.Decimal(10, 2)
  studioNotes    String?

  images Image[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([siteId, catalogueNumber])
  @@index([siteId])
}

model Image {
  id        String      @id @default(cuid())
  siteId    String
  site      Site        @relation(fields: [siteId], references: [id])
  key       String
  url       String
  kind      ImageKind   @default(PHOTO)
  mimeType  String
  caption   String?
  altText   String?
  tags      String[]    @default([])
  status    ImageStatus @default(SORTED)
  source    String?
  artworkId String?
  artwork   Artwork?    @relation(fields: [artworkId], references: [id])

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([siteId])
  @@index([artworkId])
}
