generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum ArtistStatus {
  ACTIVE
  PROSPECT
  ARCHIVED
}

enum SiteStatus {
  DRAFT
  LIVE
  PAUSED
  ARCHIVED
  // A site that currently exists elsewhere (a third-party/legacy site) that
  // will be rebuilt in Studio — a holding status while it's tracked but not
  // yet actually under construction here.
  ISYT
}

enum PageType {
  SECTION
  PRIVATE
}

enum ArtworkAvailability {
  AVAILABLE
  RESERVED
  SOLD
}

enum ImageStatus {
  HOPPER
  SORTED
  ARCHIVED
}

enum ImageKind {
  PHOTO
  VIDEO
}

enum PaymentPlanType {
  FULL
  INSTALMENTS
}

enum PaymentStatus {
  DUE
  PAID
  FAILED
}

model Artist {
  id        String       @id @default(cuid())
  name      String
  email     String?
  phone     String?
  notes     String?
  // What the artist pays Jevca for site management, and how — plain
  // record-keeping alongside notes, not connected to Stripe or any billing
  // automation (that's what the Artwork Payments panel is for — a
  // different thing: what a buyer pays for an artwork).
  subscriptionAmount Decimal? @db.Decimal(10, 2)
  paymentMethod      String?
  status    ArtistStatus @default(ACTIVE)
  createdAt DateTime     @default(now())
  updatedAt DateTime     @updatedAt
  sites     Site[]
  artworks  Artwork[]

  // Preset option lists for the Artwork Catalogue's Settings screen. Live
  // here rather than on Site because Artworks belong to the artist, not any
  // one of their sites — the same piece can be featured on more than one
  // site, so its catalogue and the presets that describe it are shared
  // across all of that artist's sites, not duplicated per site.
  artworkGroups    String[] @default([])
  artworkTypes     String[] @default([])
  artworkLocations String[] @default([])
  mediumPresets    String[] @default([])
  sizePresets      String[] @default([])

  // Preset tag list for the Media Catalogue's Settings screen — used for
  // tagging Marketing media (Related media is found via its linked
  // artwork instead, so doesn't need tags).
  mediaTags String[] @default([])

  // Global defaults for the Payments panel. Each PaymentPlan copies these
  // in once, at creation (same "seed once, then independent" pattern as
  // Presentation being seeded from Catalogue) — changing a default here
  // does not retroactively change a plan already created.
  defaultInstalmentCount     Int    @default(5)
  defaultReleaseMessage      String @default("Available for collection/delivery once 2 payments have been made.")
  defaultReleaseTriggerCount Int    @default(2)

  images Image[]
}

model Site {
  id                   String     @id @default(cuid())
  name                 String
  domain               String?
  status               SiteStatus @default(DRAFT)
  multiLanguageEnabled Boolean    @default(false)
  // Most artworks sell through a single site and inherit this — a
  // per-artwork override lives on PaymentPlan.currency for the rare
  // cross-currency sale.
  defaultCurrency      String     @default("GBP")
  // Place-marker for when the public renderer supports multiple
  // interchangeable templates (they'll all read the same underlying
  // site/page/artwork data) — not wired to anything yet.
  template             String     @default("Default")
  // Manual domain-renewal record-keeping — entered by hand for now rather
  // than synced live from Namecheap, since Namecheap's API requires a
  // fixed whitelisted IP that Netlify's serverless functions don't have.
  // Revisit if a static-IP proxy or relay server is ever set up.
  domainStatus         String?
  domainRenewalDate    DateTime?
  artistId             String
  artist               Artist     @relation(fields: [artistId], references: [id])
  createdAt            DateTime   @default(now())
  updatedAt            DateTime   @updatedAt

  pages Page[]
  menus Menu[]

  @@index([artistId])
}

model Page {
  id        String   @id @default(cuid())
  siteId    String
  site      Site     @relation(fields: [siteId], references: [id])
  type      PageType
  title     String
  slug      String
  visible   Boolean  @default(true)
  position  Int      @default(0)
  sourceTag String?

  draftBlocks Json  @default("[]")
  liveBlocks  Json?

  menuItems MenuItem[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([siteId, slug])
  @@index([siteId])
}

// A saved, named navigation arrangement. A site can have several; exactly
// one is active (used by the live site) at a time — switching which one is
// active is a single action, not a rebuild.
model Menu {
  id       String  @id @default(cuid())
  siteId   String
  site     Site    @relation(fields: [siteId], references: [id])
  name     String
  isActive Boolean @default(false)

  groups MenuGroup[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([siteId])
}

// A named cluster of menu items within one Menu (e.g. "MY GALLERIES").
// Belongs to exactly one Menu — editing one saved Menu never touches another.
model MenuGroup {
  id       String @id @default(cuid())
  menuId   String
  menu     Menu   @relation(fields: [menuId], references: [id], onDelete: Cascade)
  name     String
  position Int    @default(0)

  items MenuItem[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([menuId])
}

// One entry in a menu group. Always points at a real Page, but carries its
// own label and byline — fully independent of that Page's actual title, and
// the same Page can be featured by more than one MenuItem (different
// groups, different menus, or more than once in the same group).
model MenuItem {
  id       String    @id @default(cuid())
  groupId  String
  group    MenuGroup @relation(fields: [groupId], references: [id], onDelete: Cascade)
  pageId   String
  page     Page      @relation(fields: [pageId], references: [id])
  label    String
  byline   String?
  position Int       @default(0)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([groupId])
  @@index([pageId])
}

model Artwork {
  id       String @id @default(cuid())
  artistId String
  artist   Artist @relation(fields: [artistId], references: [id])

  // Catalogue number is the record's identifier — auto-generated, unique
  // per artist (not per site, since the same artwork can appear on more
  // than one of that artist's sites).
  catalogueNumber String

  // --- Presentation facet: what customers see on the public site ---
  presentationTitle String
  presentationPrice Decimal?            @db.Decimal(10, 2)
  dimensions        String?
  description       String?
  medium            String?
  presentationGroup String?
  availability      ArtworkAvailability @default(AVAILABLE)
  visible           Boolean             @default(true)

  // --- Catalogue facet: the artist's private working record ---
  catalogueName  String
  year           Int?
  type           String?
  catalogueGroup String?
  size           String?
  location       String?
  edition        String?
  availableQty   Int?
  priceUnframed  Decimal? @db.Decimal(10, 2)
  priceFramed    Decimal? @db.Decimal(10, 2)
  studioNotes    String?

  images Image[]

  // One active plan per artwork at a time — a deliberate v1 simplification
  // (same spirit as the other 80/20 calls in this project). The rare case
  // of an artwork being re-sold after a cancelled/failed plan is handled
  // manually: delete the old plan, start a new one.
  paymentPlan PaymentPlan?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([artistId, catalogueNumber])
  @@index([artistId])
}

// The sale terms for one artwork: full payment or instalments, currency,
// the buyer, and the editable release message/trigger. Actual Stripe
// objects (Customer, Checkout Session, Subscription) are referenced by ID
// only — Stripe itself remains the source of truth for whether money has
// actually moved (see Payment.status, updated only via webhook).
model PaymentPlan {
  id        String  @id @default(cuid())
  artworkId String  @unique
  artwork   Artwork @relation(fields: [artworkId], references: [id])

  type        PaymentPlanType @default(FULL)
  totalAmount Decimal         @db.Decimal(10, 2)
  currency    String          @default("GBP")

  // Only meaningful when type = INSTALMENTS.
  instalmentCount Int?

  // Seeded from the Artist's global defaults at creation, then fully
  // independent and editable per artwork from that point on.
  releaseMessage      String?
  releaseTriggerCount Int?

  buyerName  String?
  buyerEmail String?

  stripeCustomerId             String?
  stripeCheckoutSessionId      String?
  stripeSubscriptionScheduleId String?
  stripeSubscriptionId         String?

  payments Payment[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([artworkId])
}

// One row per actual instalment (or the single row for a Full payment).
// Status only ever changes in response to a Stripe webhook event — never
// set optimistically from the admin UI — so it always reflects what
// Stripe actually confirms happened.
model Payment {
  id     String      @id @default(cuid())
  planId String
  plan   PaymentPlan @relation(fields: [planId], references: [id], onDelete: Cascade)

  sequence Int // 1st payment, 2nd, etc. — 1 for a Full payment.
  amount   Decimal       @db.Decimal(10, 2)
  currency String
  status   PaymentStatus @default(DUE)

  dueDate  DateTime?
  paidDate DateTime?

  stripePaymentIntentId String?
  stripeInvoiceId       String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([planId])
}

model Image {
  id       String @id @default(cuid())
  artistId String
  artist   Artist @relation(fields: [artistId], references: [id])
  key       String
  url       String
  // A still frame grabbed client-side at upload time, so a video has a
  // real thumbnail in the catalogue grid instead of a generic placeholder.
  // Null for photos, and for any video uploaded before this existed.
  posterUrl String?
  kind      ImageKind   @default(PHOTO)
  mimeType  String
  caption   String?
  altText   String?
  tags      String[]    @default([])
  status    ImageStatus @default(SORTED)
  source    String?
  artworkId String?
  artwork   Artwork?    @relation(fields: [artworkId], references: [id])

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([artistId])
  @@index([artworkId])
}
