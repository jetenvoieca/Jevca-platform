generator client {
  provider        = "prisma-client"
  output          = "../src/generated/prisma"
  previewFeatures = ["relationJoins"]
}

datasource db {
  provider = "postgresql"
}

enum ArtistStatus {
  ACTIVE
  PROSPECT
  ARCHIVED
}

enum StripeMode {
  TEST
  LIVE
}

enum SiteStatus {
  DRAFT
  LIVE
  PAUSED
  ARCHIVED
  ISYT
}

// A Page Style's Style Type (2026-10-04) — each a fundamentally
// different way of building a page, not a different look. BLOCK_BUILD
// (2026-10-07, was PRIVATE / "Private / Custom"): a page built from
// components, each filled from the page's curation. CANVAS (2026-10-05):
// the curations placed on a canvas that scrolls in any direction. See
// lib/pageStyleTypes.ts. Section and the old page editors' types were
// removed 2026-10-07.
enum PageStyleType {
  BLOCK_BUILD
  CANVAS
}

enum ArtworkAvailability {
  AVAILABLE
  RESERVED
  SOLD
}

// A Location's owner (2026-09-22, Sold-routing rework — see the note on
// Location below). GALLERY = a third-party gallery: has full contact
// details and its own commission on a sale. OWN = anywhere the artist
// keeps their own stock (studio, storage, framer) — no commission, a
// plain 0%, but otherwise tracked exactly the same way (Consigned/held
// works, a sale panel, its own Purchase history).
enum LocationType {
  GALLERY
  OWN
}

enum ImageStatus {
  HOPPER
  SORTED
  ARCHIVED
  BUCKET
}

enum ImageKind {
  PHOTO
  VIDEO
}

enum PurchaseType {
  FULL
  INSTALMENTS
}

enum SaleChannel {
  STRIPE
  GALLERY
}

enum PurchaseStatus {
  ACTIVE
  COMPLETED
  ABANDONED
}

// What a follow-on charge sale is for (2026-09-23) — see
// Purchase.parentPurchaseId.
enum ChargeKind {
  FRAMING
  DELIVERY
}

enum PaymentStatus {
  DUE
  PAID
  FAILED
}

// The two fixed guide categories shown as pill tabs on the Guides page
// (2026-09-04) — deliberately a real enum, not a Settings-editable list
// like Artist.paymentMethods: confirmed as always exactly these two,
// never a third.
enum GuideCategory {
  USER
  TECHNICAL
}

// The Inbox's two mailboxes (2026-09-27) — ART is everything at
// jevca.art (every artist's address and craig@jevca.art), BUSINESS is
// everything at jetenvoieca.com. Decided by domain alone — see
// mailboxForAddress in lib/email.ts.
enum Mailbox {
  ART
  BUSINESS
}

// The kinds of section a curation's presentation can have (2026-10-06)
// — see CurationSection.
enum CurationSectionType {
  TAGLINE
  DESCRIPTION
  VIDEO
  TEXT
  IMAGES
}

// Whether a subscriber receives campaign mail (2026-10-08). An
// unsubscribed person is kept on record, never deleted automatically,
// so a later import can never subscribe them again — see Subscriber.
// BOUNCED / COMPLAINED (2026-10-09): set from Resend's webhook when a
// campaign mail hard-bounces or is marked as spam. Like UNSUBSCRIBED,
// they're never sent campaigns again (until set back by hand).
enum SubscriberStatus {
  SUBSCRIBED
  UNSUBSCRIBED
  BOUNCED
  COMPLAINED
}

// How a subscriber was added (2026-10-08): typed in by hand, from a CSV
// import, from one of the artist's Customers, or (later) the sign-up
// form on the artist's own website.
enum SubscriberSource {
  MANUAL
  IMPORT
  CUSTOMER
  WEBSITE
}

model Artist {
  id        String       @id @default(cuid())
  name      String
  firstName String?
  email     String?
  phone     String?
  notes     String?

  // Personal Profile tab (2026-08-31) — a portrait photo and free-text
  // bio shown on the artist's own profile. The photo is picked from the
  // artist's existing Media Catalogue via MediaPicker (2026-08-31,
  // direct request — "keep everything in one place" rather than a
  // separate direct upload), so this is a relation to an existing
  // Image row, the same pattern as Artwork.mainImageId below, not its
  // own upload path like `logoUrl` (which deliberately stays outside
  // the Media Catalogue — see the note there).
  profileImageId String? @unique
  story          String?
  // How the artist writes (2026-10-08) — given to the translator when a
  // campaign mail is translated into French, so the French reads in
  // their voice (lib/actions/translateMail.ts).
  writingVoice   String?

  hopperToken String @unique @default(cuid())

  // Local part of this artist's own address on the platform's shared
  // domain (2026-09-05, Email Integration) — combined with the fixed
  // "@jevca.art" suffix (see lib/email.ts) to build both the "from"
  // address used when sending invoices/receipts/certificates, and the
  // address inbound replies are matched against (see
  // processInboundEmail in lib/actions/inboundEmail.ts). Auto-suggested
  // from the artist's name when the artist is created
  // (generateUniqueEmailSlug in lib/emailSlug.ts), editable afterwards
  // in Settings, and always sanitised/deduped through that same
  // function so it can never collide with another artist's slug or a
  // reserved address (craig@, admin@, etc — see RESERVED_SLUGS there).
  emailSlug String? @unique

  subscriptionAmount Decimal? @db.Decimal(10, 2)
  paymentMethod      String?
  // Per-artist, not global — added 2026-08-09 so one artist can go live
  // on real Stripe charges while every other artist stays on Test,
  // safely isolated from each other on the same shared Stripe account.
  // Defaults TEST so nothing changes for any existing artist.
  stripeMode StripeMode @default(TEST)
  status    ArtistStatus @default(ACTIVE)
  createdAt DateTime     @default(now())
  updatedAt DateTime     @updatedAt
  sites     Site[]
  artworks  Artwork[]
  customers Customer[]
  locations Location[]
  // Named, ordered selections of this artist's artworks (2026-09-24) —
  // see Curation below.
  curations Curation[]

  // Deprecated (2026-08-28) — superseded by the real ArtworkType table
  // below, which adds a per-type Ref value (used to compute Reference
  // price) that a plain string list has nowhere to hold. Column kept,
  // not dropped, only because a one-off data migration reads it once to
  // seed ArtworkType; nothing in the app reads or writes it any more.
  artworkTypes     String[] @default([])
  // Deprecated (2026-09-22) — superseded by the real Location table
  // below, which every Artwork's Location dropdown now reads from
  // instead (guarantees an exact match against a real Gallery/Own
  // Location, rather than free text that could silently drift out of
  // sync — see the note on Location). Column kept, not dropped, only
  // because the Location backfill migration reads it once to carry
  // across any preset never actually used on an artwork; nothing in the
  // app reads or writes it any more.
  artworkLocations String[] @default([])
  mediumPresets    String[] @default([])
  sizePresets      String[] @default([])

  mediaTags String[] @default([])

  saleSources String[] @default([])

  // Editable per artist (2026-08-27), same pattern as the preset lists
  // above — was a fixed database enum at first, changed once it became
  // clear it needed to be a Settings-editable list like everything else
  // here, not something requiring a migration to change.
  expenseCategories String[] @default(["Materials", "Studio", "Framing", "Insurance", "Equipment", "Shipping", "Professional fees", "Travel", "Marketing", "Other"])

  // Offered as the "Method" dropdown when marking a gallery sale paid
  // (2026-09-03) — same Settings-editable-list pattern as
  // expenseCategories/saleSources above, edited via the same
  // SettingsListCard. See recordGalleryPayment in lib/actions/payments.ts
  // and Payment.method below.
  paymentMethods String[] @default(["Bank transfer", "Cash", "Cheque", "Card", "PayPal"])

  logoUrl           String?

  // Structured postal address (2026-09-06, reformed from a single
  // freeform `invoiceAddress` field, direct request — "reform the
  // Artist address field so it can be used wherever needed") — split
  // out so any document needing just one piece can pull exactly that,
  // rather than parsing a blob of free text. The Certificate of
  // Authenticity's signature block, for instance, needs only postcode +
  // country (e.g. "11440, France") — see certificate.ts.
  // addressLine1 stays free text (a street address can genuinely span
  // more than one line); city/postcode/country are split out because
  // they're the pieces reused individually elsewhere.
  addressLine1 String?
  city         String?
  postcode     String?
  country      String?

  vatNumber         String?
  vatRate           Decimal? @db.Decimal(5, 2)
  invoiceFooterText String?
  // "EN" or "FR" — deliberately independent of the sale's currency
  // (2026-08-13): a EUR sale isn't necessarily to a French-speaking
  // buyer, so this is the artist's own explicit choice, not inferred.
  invoiceLanguage   String   @default("EN")
  nextInvoiceNumber Int      @default(1)

  // The artist's signature image for the Certificate of Authenticity
  // (2026-09-03) — deliberately its own upload, separate from `logoUrl`
  // above: for some artists (e.g. Louise Dear) the two happen to be the
  // same image, but that isn't true for every artist, so this isn't
  // just a second reference to logoUrl. Same "business asset, not
  // artwork media" reasoning as logoUrl — uploaded directly, not picked
  // via MediaPicker from the Media Catalogue.
  signatureUrl String?

  defaultInstalmentCount     Int    @default(5)
  defaultReleaseMessage      String @default("Available for collection/delivery once 2 payments have been made.")
  defaultReleaseTriggerCount Int    @default(2)

  // Platform subscription (the artist paying US for their site/hosting) —
  // deliberately separate from `stripeMode`/StripeCustomer used elsewhere,
  // which is about THIS artist's own buyers paying THEM. This is a
  // different Stripe account entirely (2026-08-13 decision), so a
  // different Customer ID lives here. Linked manually (pasted in once),
  // not auto-matched by email.
  stripeSubscriptionCustomerId String? @unique
  stripeSubscriptionStatus     String?

  images Image[]
  // Picked via MediaPicker from this same artist's Media Catalogue — see
  // the note by profileImageId above.
  profileImage Image? @relation("ArtistProfileImage", fields: [profileImageId], references: [id])
  videoRenders VideoRender[]
  subscriptionPayments SubscriptionPayment[]
  alertEvents AlertEvent[]
  expenses Expense[]
  artworkTypeRecords ArtworkType[]
  certificateTemplates CertificateTemplate[]
  // Every reply received at this artist's own address, and every ad hoc
  // email or reply sent as/to them — see InboundEmail/OutboundEmail
  // below (2026-09-05, Email Integration).
  inboundEmails  InboundEmail[]
  outboundEmails OutboundEmail[]
  // Tasks linked to this artist on the admin Inbox's Task view
  // (2026-09-19, CRM Phase 2) — see Task below.
  tasks Task[]
  // The artist's own Stripe account, linked through Stripe Connect
  // (2026-09-25) — at most one per mode. See StripeConnection below.
  stripeConnections StripeConnection[]
  // Marketing (2026-10-08) — the artist's mailing-list subscribers and
  // their named mail lists. See Subscriber and MailList below.
  subscribers Subscriber[]
  mailLists   MailList[]
}

// An artist's own Stripe account, linked to the platform (Jetenvoieca)
// through Stripe Connect OAuth (2026-09-25). While one exists for the
// artist's current stripeMode, every NEW sale is taken straight into that
// account (a "direct charge"); with none, sales use Jetenvoieca's own
// account as before. Test and Live are separate Stripe accounts on
// Stripe's side, so each mode has its own row.
//
// A sale never follows later changes to this — see Purchase.stripeAccountId.
model StripeConnection {
  id       String     @id @default(cuid())
  artistId String
  artist   Artist     @relation(fields: [artistId], references: [id], onDelete: Cascade)
  mode     StripeMode
  // The connected account's id (acct_...) — sent as the Stripe-Account
  // header on every call made for this artist's sales.
  accountId String
  // The account's display name as Stripe reported it when linked (e.g.
  // "La galerie") — shown in Settings, never used for payments.
  accountName String?
  connectedAt DateTime @default(now())

  @@unique([artistId, mode])
  @@index([accountId])
}

// Replaces the plain-string `Artist.artworkTypes` list (2026-08-28) — a
// real Type now carries a Ref value (0.5–2.0) used to suggest a
// Reference price on the Catalogue tab: (Size preset's width × height)
// × this Ref value. `type` stays free text on Artwork itself, matched by
// name against this list, same convention already used for Location/
// Medium — not a hard foreign key, so nothing breaks if a Type is later
// renamed or removed while artworks still reference the old name.
model ArtworkType {
  id       String  @id @default(cuid())
  artistId String
  artist   Artist  @relation(fields: [artistId], references: [id])

  name     String
  refValue Decimal @default(1.00) @db.Decimal(3, 2)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([artistId, name])
  @@index([artistId])
}

// Editable Certificate of Authenticity wording (2026-09-03) — one entry
// per artwork Type-ish category (Original / Unique / Edition, etc.),
// each with a label matched against Artwork.type (same free-text-match
// convention as ArtworkType above — not a hard foreign key) and its own
// certifying text, e.g. "I certify that this work is a unique original
// Artwork created by myself". Own table rather than a plain string list
// (like Artist.paymentMethods) since each entry needs two fields, not
// one — same reasoning as ArtworkType existing as its own table instead
// of a string list once it needed a second value (refValue) alongside
// the name.
model CertificateTemplate {
  id       String @id @default(cuid())
  artistId String
  artist   Artist @relation(fields: [artistId], references: [id])

  label String
  text  String

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([artistId])
}

// One unified ledger of "artist paid us for their subscription" rows,
// regardless of source — a manual PayPal/DD entry and a Stripe-synced
// invoice look identical once they land here, so the display grid never
// needs to know which one it's showing (2026-08-13 decision).
model SubscriptionPayment {
  id       String @id @default(cuid())
  artistId String
  artist   Artist @relation(fields: [artistId], references: [id])

  source   String   // "STRIPE" | "MANUAL"
  amount   Decimal  @db.Decimal(10, 2)
  currency String   @default("GBP")
  paidAt   DateTime

  // Dedupe key for the Stripe webhook (Phase 2) — never set for manual
  // rows. Ensures a re-delivered webhook event can't double-count.
  stripeInvoiceId String? @unique

  note String?

  createdAt DateTime @default(now())

  @@index([artistId])
}

// Generic "something needs your attention" record (2026-08-13) —
// deliberately not payments-specific in shape, even though the only two
// types today are subscription-related, since the stated intent is one
// dashboard that can grow to cover other kinds of alerts later without a
// schema rework. `resolvedAt` null = still open; auto-resolved by the
// webhook handler when the underlying issue clears (e.g. a payment
// succeeds after a prior failure), or dismissible by hand.
//
// Also used for EMAIL_REPLY_RECEIVED (2026-09-05, Email Integration) —
// raised when a reply lands for a given artist, auto-resolved the first
// time that reply is actually opened in the inbox (getThread in
// lib/actions/inboundEmail.ts), same self-clearing pattern as the
// subscription alerts.
//
// And for SALE_RECORDED / SALE_LINK_CREATED (2026-09-21) — raised by the
// Studio app when an artist records a sale, takes a card payment, or
// creates a payment link; see purchaseId below.
model AlertEvent {
  id       String @id @default(cuid())
  type     String // "SUBSCRIPTION_PAYMENT_FAILED" | "SUBSCRIPTION_CANCELLED" | "EMAIL_REPLY_RECEIVED" | "SALE_RECORDED" | "SALE_LINK_CREATED"
  severity String @default("WARNING") // "INFO" | "WARNING" | "CRITICAL"
  message  String

  artistId String?
  artist   Artist? @relation(fields: [artistId], references: [id])

  // The sale this alert is about, for the two sale alert types above
  // (2026-09-21) — lets the Inbox open that sale exactly as the Sales page
  // does. Null for every other alert type, and set back to null if the
  // sale is later deleted (the alert itself stays).
  purchaseId String?
  purchase   Purchase? @relation(fields: [purchaseId], references: [id], onDelete: SetNull)

  resolvedAt DateTime?
  createdAt  DateTime  @default(now())

  @@index([artistId])
  @@index([purchaseId])
  @@index([resolvedAt])
}

// Scoped to one artist, deliberately — even the same real-world gallery
// buying from two different artists gets a separate Customer record for
// each (2026-08-13 decision), since terms and contacts can genuinely
// differ artist to artist. Cross-artist awareness is handled separately,
// by matching email addresses live at read time rather than sharing or
// merging records — see getCustomerDetail in actions/customers.ts.
model Customer {
  id       String @id @default(cuid())
  artistId String
  artist   Artist @relation(fields: [artistId], references: [id])

  // "INDIVIDUAL" | "GALLERY" | "OWN" (2026-08-14, extended 2026-09-22) —
  // kept as a free string, same convention as Artist.paymentMethod
  // elsewhere, rather than an enum: this is UI-facing categorisation,
  // not a value with referential integrity concerns. "OWN" is new
  // (2026-09-22, Location rework) — the backing Customer record every
  // Own-type Location gets, purely so every existing piece of sale/
  // invoice machinery (Purchase.customerId, GallerySaleCard, invoicing)
  // keeps working completely unchanged for a studio/own-stock sale too,
  // not just a real gallery's. Never shown as a contactable customer
  // anywhere — always reached via its Location instead. See Location
  // below.
  kind String @default("INDIVIDUAL")

  name    String
  // Split out 2026-08-14, alongside the CSV import — kept in sync with
  // `name` (still the single source of truth for display everywhere:
  // sale records, invoices, the customer list) rather than replacing
  // it, so nothing existing needs to change. Individual-only in
  // practice; a Gallery's `name` is the gallery's own name and these
  // stay null for it. The actual point of splitting them is future
  // mailshots wanting "Hi Sarah," not "Hi Sarah Jenkins,".
  firstName String?
  lastName  String?
  email   String?
  phone   String?
  address String?

  // Gallery-only fields (2026-08-14) — a gallery is dealt with as a
  // business, but sold to and invoiced through a named person there,
  // hence separate from the business's own name/email above.
  contactName  String?
  contactEmail String?
  websiteName  String?
  websiteUrl   String?
  instagramUrl String?
  facebookUrl  String?
  // The gallery's usual cut — a starting point to prefill with when
  // starting a sale, not binding on any individual sale (each Purchase
  // keeps its own commissionPercent, which can still be typed/changed
  // per sale). Always null/0 in practice for an "OWN" kind record — see
  // the note on Customer.kind above.
  defaultCommissionPercent Decimal? @db.Decimal(5, 2)
  // "PROSPECT" | "ACTIVE" (2026-08-14) — gallery relationship pipeline,
  // simple two-stage per explicit decision. Left null for Individuals
  // (not applicable); set to "PROSPECT" when a new Gallery contact is
  // created, moved to "ACTIVE" by hand once actually working together.
  relationshipStatus String?
  // "EN" or "FR", or null to fall back to the artist's own default
  // (Settings → Invoice language). An explicit per-customer override,
  // not a duplicate of the artist-level setting.
  language String?

  notes String?

  purchases Purchase[]

  // Best-effort tags on inbound/outbound email (2026-09-05, Email
  // Integration) — matched by comparing the sender's/recipient's address
  // against this customer's own email/contactEmail at the time a message
  // is sent or received. See InboundEmail/OutboundEmail below.
  inboundEmails  InboundEmail[]
  outboundEmails OutboundEmail[]

  // The Location this Customer record backs, if any (2026-09-22) — set
  // for every "GALLERY" and "OWN" kind Customer, null for a plain
  // "INDIVIDUAL" buyer. See Location below.
  location Location?

  // Subscribers added from this customer (2026-10-08) — see
  // Subscriber.customerId.
  subscribers Subscriber[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([artistId])
  @@index([email])
}

// A place an artwork can be — a real Gallery (third-party, GALLERY) or
// somewhere the artist keeps their own stock (OWN — studio, storage,
// framer). Added 2026-09-22, replacing the old free-text-only
// Artist.artworkLocations list as the single canonical set of names the
// Artwork Catalogue's Location dropdown offers, so a Location can never
// silently drift out of sync with a Gallery's own name the way a typed
// string could (see the old note on getGalleryDetail in
// actions/customers.ts).
//
// Every Location — Own included — has its own backing Customer record
// (see Customer.kind above), so pressing "Sold" on an artwork always
// routes to the exact same kind of panel (consigned/held works, a sale
// panel, a Purchase history) regardless of whether the piece is at a
// real gallery or the artist's own studio; only the commission differs
// (fixed 0% for OWN).
//
// Artwork.location remains a plain free-text column for now (not a
// foreign key here) — matched by exact name against Location.name, the
// same convention already used for Type/Medium presets. Renaming a
// Location cascades that name across every Artwork.location that
// currently matches it — see renameLocation in actions/locations.ts.
model Location {
  id       String @id @default(cuid())
  artistId String
  artist   Artist @relation(fields: [artistId], references: [id])

  name String
  type LocationType @default(OWN)

  customerId String   @unique
  customer   Customer @relation(fields: [customerId], references: [id])

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([artistId, name])
  @@index([artistId])
}

// A named, ordered selection of an artist's artworks (2026-09-24) —
// e.g. "Signature Pieces". Replaced the old Tier and Group fields
// (removed the same day): how works are grouped for display and
// marketing is a presentation choice, not a fact about the artwork
// itself, so it doesn't belong in the catalogue. Belongs to the artist
// (not a Site), same as Artwork, so any of the artist's sites can use
// the same curation. An artwork can be in any number of curations —
// see CurationItem below. Each work's presentation within a curation
// (its Description and images) is edited on the Curations page
// (2026-10-03). A website page can show one curation (2026-10-04) — see
// Page.curationId — or, on a Canvas page, several (2026-10-05) — see
// PageCanvasItem. The curation's own presentation — tag line,
// description, video and so on — is its sections (2026-10-06, which
// replaced a single Description column) — see CurationSection.
model Curation {
  id       String @id @default(cuid())
  artistId String
  artist   Artist @relation(fields: [artistId], references: [id])

  name String

  items    CurationItem[]
  sections CurationSection[]
  // Website pages showing this curation (2026-10-04) — see Page.curationId.
  pages Page[]
  // Canvas pages it's placed on (2026-10-05) — see PageCanvasItem.
  canvasItems PageCanvasItem[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([artistId, name])
  @@index([artistId])
}

// One section of a curation's presentation (2026-10-06, from Craig's
// mockups), shown in order in the curation panel on a page: a Tag line
// (`text`, one line), a Description (`text`), Free text (`heading` +
// `text`), a Video (one video from the Media Catalogue, in `media`) or
// Images (photos from the Media Catalogue, in `media`, shown one under
// another). Any type can be used any number of times; `position` sets
// the order (0 first). Edited on the Curations page. Removed with its
// curation. Text sections are plain text (2026-10-07 — their height and
// background colour were removed). Can also be put in a Block Build
// page's components (2026-10-07) — see PageComponentContent.
model CurationSection {
  id         String              @id @default(cuid())
  curationId String
  curation   Curation            @relation(fields: [curationId], references: [id], onDelete: Cascade)
  type       CurationSectionType
  position   Int                 @default(0)

  heading String?
  text    String?
  media   CurationSectionMedia[]

  pageComponents PageComponentContent[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([curationId, position])
}

// One video or image in a curation section (2026-10-06) — see
// CurationSection. `position` orders them (0 first). Removed if the
// section or the image itself is deleted.
model CurationSectionMedia {
  id        String          @id @default(cuid())
  sectionId String
  section   CurationSection @relation(fields: [sectionId], references: [id], onDelete: Cascade)
  imageId   String
  image     Image           @relation(fields: [imageId], references: [id], onDelete: Cascade)

  position Int

  @@unique([sectionId, imageId])
  @@index([sectionId, position])
  @@index([imageId])
}

// One artwork's place in one Curation (2026-09-24). `position` sets the
// order within the curation (0 first). An artwork appears at most once
// per curation. Removed automatically if either the curation or the
// artwork is deleted — removing a work from a curation never touches
// the artwork itself.
model CurationItem {
  id         String   @id @default(cuid())
  curationId String
  curation   Curation @relation(fields: [curationId], references: [id], onDelete: Cascade)
  artworkId  String
  artwork    Artwork  @relation(fields: [artworkId], references: [id], onDelete: Cascade)

  position Int @default(0)

  // This work's Description within this curation only (2026-10-03) —
  // the same artwork can read differently in each curation. Null until
  // someone writes one on the Curations page; until then the page shows
  // the artwork's own Type, Size and Medium (one per line), always
  // current with the Catalogue. Once written it's kept as written ("" if
  // deliberately cleared) and never re-synced. Name and price are not
  // per curation — they stay the artwork's own.
  description String?

  // This work's images within this curation only (2026-10-03) — same
  // rule as description. While false it shows the artwork's own images
  // (Catalogue Main first). The first image change made on the Curations
  // page (make main, remove, add) gives it its own set, held in `images`
  // below, and sets this true; from then on the Catalogue's images no
  // longer affect it, and nothing done here changes the Catalogue.
  ownImages Boolean             @default(false)
  images    CurationItemImage[]

  createdAt DateTime @default(now())

  @@unique([curationId, artworkId])
  @@index([curationId, position])
  @@index([artworkId])
}

// One image in a work's own image set within a curation (2026-10-03) —
// see CurationItem.ownImages. Up to 4 per work, like an artwork's own
// images; position 0 is this curation's main image. Any image of the
// artist's can be used, whether or not it's linked to the artwork. Removed
// automatically if the image itself is deleted.
model CurationItemImage {
  id             String       @id @default(cuid())
  curationItemId String
  curationItem   CurationItem @relation(fields: [curationItemId], references: [id], onDelete: Cascade)
  imageId        String
  image          Image        @relation(fields: [imageId], references: [id], onDelete: Cascade)

  position Int

  @@unique([curationItemId, imageId])
  @@index([curationItemId, position])
  @@index([imageId])
}

// One unified messaging inbox for every address on the platform's
// shared domain (2026-09-05, Email Integration) — every artist's own
// address (louise.dear@jevca.art, via Artist.emailSlug) and the general
// admin address (craig@jevca.art, PlatformSettings.adminEmailAddress)
// all land here, in one box that's then filtered by artist/gallery in
// the UI, rather than as separate per-artist inboxes — this was a
// direct decision (2026-09-05): easier to scan across 100+ artists from
// one screen than to maintain a mailbox per artist.
//
// Since 2026-09-27 the business's own addresses (jetenvoieca.com) land
// here too, as a second mailbox — see `mailbox` below.
//
// Deliberately not scoped to a Purchase/sale — an inbound reply is
// matched to an Artist (by which address it was sent to) and,
// best-effort, to a Customer (by matching the sender's address against
// that artist's own Customer records) purely so the inbox can be
// filtered, not because every email is about one specific sale.
model InboundEmail {
  id String @id @default(cuid())

  // Resend's own id for this message — the dedupe key if a webhook is
  // ever redelivered (Resend's own retry behaviour), and needed to fetch
  // the full HTML/Plain Text body from the Receiving API (webhooks only
  // carry metadata — see processInboundEmail in
  // lib/actions/inboundEmail.ts).
  resendEmailId String  @unique
  // RFC Message-ID header, always stored with its angle brackets (see
  // canonicalMessageId, lib/emailThreading.ts) — used as In-Reply-To when
  // replying, and to link a later reply back to a task.
  messageId     String?

  fromAddress String
  fromName    String?
  toAddress   String // whichever of our addresses it was actually sent to.

  // Which of the Inbox's two mailboxes this belongs to (2026-09-27) —
  // set from toAddress's domain when it arrives.
  mailbox Mailbox @default(ART)

  // Art: resolved from toAddress's local part against Artist.emailSlug —
  // null for anything sent to the general admin address, or to an
  // address that doesn't match any artist (shown unfiltered in the inbox
  // either way, never dropped). Business: the artist (a client of the
  // business) whose own Artist.email the message came from, if any.
  artistId String?
  artist   Artist? @relation(fields: [artistId], references: [id])

  // Best-effort tag for the inbox filter (see the model-level note
  // above) — matched by fromAddress against this same artist's own
  // Customer.email/contactEmail at receive time. Art only. Never
  // re-matched after the fact if a Customer record changes later.
  customerId String?
  customer   Customer? @relation(fields: [customerId], references: [id])

  subject  String?
  textBody String?
  htmlBody String?

  isRead Boolean @default(false)

  // When this message was archived (2026-09-27) — null while it's in the
  // Inbox. Archived messages show only in the Inbox's "Archived" view,
  // and can be moved back. See archiveInboundEmail in
  // lib/actions/inboundEmail.ts.
  archivedAt DateTime?

  // The task this is a reply to (2026-09-27) — set when its In-Reply-To/
  // References headers point at an email sent from a task, or at an
  // earlier message already linked to one (see findTaskForReply,
  // lib/emailThreading.ts). Cleared if the task is deleted; the message
  // itself stays in the Inbox.
  taskId String?
  task   Task?   @relation(fields: [taskId], references: [id], onDelete: SetNull)

  receivedAt DateTime @default(now())

  replies     OutboundEmail[]
  attachments InboundEmailAttachment[]

  @@index([artistId])
  @@index([customerId])
  @@index([toAddress])
  @@index([mailbox, archivedAt, receivedAt])
  @@index([taskId])
  @@index([messageId])
}

// A file attached to an inbound email (2026-09-24). Resend only offers
// attachments through short-lived download links, so each one is copied
// into our own R2 storage the moment the email arrives (see
// saveInboundAttachments in lib/actions/inboundEmail.ts) and served back
// only through the login-protected /api/inbound-attachment/[id] route.
// Files over 20 MB are listed but not copied (direct decision), and a
// copy that fails is listed the same way — in both cases r2Key stays
// null. Deleted along with its email.
model InboundEmailAttachment {
  id String @id @default(cuid())

  inboundEmailId String
  inboundEmail   InboundEmail @relation(fields: [inboundEmailId], references: [id], onDelete: Cascade)

  filename    String
  contentType String
  size        Int
  r2Key       String?

  createdAt DateTime @default(now())

  @@index([inboundEmailId])
}

// The other half of the same inbox (see InboundEmail above) — every ad
// hoc email Craig sends from the Inbox's Compose screen, every reply
// sent from within an open thread, AND (2026-09-05, second Email
// Integration request — "add a Sent view showing everything") every
// invoice/receipt/certificate send too, purely so the Sent list has one
// place to read from. Purchase's own invoiceEmailedAt/invoiceEmailedTo/
// certificateEmailedAt/certificateEmailedTo fields are unchanged and
// still what the per-sale card reads for its own "Invoice sent [date]"
// line — this table doesn't replace them, it's an additional record
// written alongside them purely for this unified view.
model OutboundEmail {
  id String @id @default(cuid())

  resendEmailId String? @unique

  // The RFC Message-ID the email went out with (2026-09-27), with angle
  // brackets — only recorded for task emails (and replies within a task's
  // conversation), so a reply to one can be linked back to the task. Read
  // from Resend just after sending; if it isn't ready yet it's fetched
  // when a reply arrives (see lib/emailThreading.ts).
  messageId String?

  fromAddress String
  toAddress   String
  subject     String?
  body        String?

  // What this send actually was, for the Sent list: "ADMIN" (ad hoc
  // Compose), "REPLY" (from an open thread), "TASK" (sent from a task,
  // 2026-09-27), "INVOICE", "RECEIPT", or "CERTIFICATE". INVOICE vs
  // RECEIPT is decided by invoiceEmail.ts from the sale's paid status at
  // the moment it's sent — same distinction already used for the email
  // wording itself. Free string, not an enum, same convention as
  // Customer.kind above — purely UI-facing.
  kind String @default("ADMIN")

  // Which mailbox's Sent list this shows in (2026-09-27) — the mailbox
  // it was composed in, or of the message it replies to. Invoice/
  // receipt/certificate sends are always Art.
  mailbox Mailbox @default(ART)

  // Set only for INVOICE/RECEIPT/CERTIFICATE sends, so the Sent list can
  // show which sale a send belongs to — never set for ADMIN/REPLY.
  purchaseId String?
  purchase   Purchase? @relation(fields: [purchaseId], references: [id])

  // Same "which artist/gallery does this belong to, for the filter"
  // purpose as InboundEmail.artistId/customerId above. For a reply, both
  // are copied straight from the message being replied to rather than
  // re-resolved.
  artistId String?
  artist   Artist? @relation(fields: [artistId], references: [id])

  customerId String?
  customer   Customer? @relation(fields: [customerId], references: [id])

  // Set only when this is a reply to a specific inbound message — how
  // the thread view knows what it's a reply to, and what to put in the
  // outgoing In-Reply-To header so it threads correctly in the
  // recipient's own mail client.
  inReplyToId String?
  inReplyTo   InboundEmail? @relation(fields: [inReplyToId], references: [id])

  // The task this was sent from, or whose conversation it continues
  // (2026-09-27). Cleared if the task is deleted; the email itself stays
  // in the Sent list.
  taskId String?
  task   Task?   @relation(fields: [taskId], references: [id], onDelete: SetNull)

  sentAt DateTime @default(now())

  @@index([artistId])
  @@index([customerId])
  @@index([inReplyToId])
  @@index([purchaseId])
  @@index([mailbox, sentAt])
  @@index([taskId])
  @@index([messageId])
}

// A to-do item on the admin Inbox's Task view (2026-09-19, CRM Phase 2)
// — the start of a client-relationship-management panel. artistId is
// optional: a task can be general ("renew the Netlify plan") or tied to
// one artist, in which case the Inbox's artist filters apply to it.
// `category` is free text matched against
// PlatformSettings.taskCategories, same convention as
// PlatformExpense.category — not a hard foreign key, so renaming or
// removing a category never breaks an existing task. A task is open
// while completedAt is null; completing it sets completedAt, which is
// what the Done list reads.
model Task {
  id String @id @default(cuid())

  artistId String?
  artist   Artist? @relation(fields: [artistId], references: [id])

  name        String
  description String?
  // The person this task is about, if any (2026-09-27) — the address
  // "Send email" on the task is pre-filled with. Free text, not a link to
  // a Customer/Artist record, same as the compose form's To.
  email       String?
  // A calendar date, not a moment — stored as a plain DATE so it can
  // never drift by a day across timezones.
  targetDate  DateTime? @db.Date
  category    String?
  // The Paris date the task was marked Today for (2026-10-09). It sits in
  // the tinted Today panel at the top of the list only while this is
  // today's date, so the panel empties itself at midnight; null = never
  // marked, or taken off with Not today.
  todayOn     DateTime? @db.Date

  completedAt DateTime?

  // Emails sent from this task, and replies to them (2026-09-27) — see
  // OutboundEmail.taskId / InboundEmail.taskId — and notes of what was
  // done (2026-09-28, see TaskNote). All shown as the task's Activity.
  outboundEmails OutboundEmail[]
  inboundEmails  InboundEmail[]
  notes          TaskNote[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([artistId])
  @@index([completedAt])
}

// A note of something done for a task (2026-09-28, direct request — "take
// note of what we have done"): a date and a line or two of text, added
// from the task's Activity button and shown in its Activity alongside the
// emails. Editable and deletable; deleted along with its task.
model TaskNote {
  id     String @id @default(cuid())
  taskId String
  task   Task   @relation(fields: [taskId], references: [id], onDelete: Cascade)

  // A calendar date, not a moment — same as Task.targetDate.
  date DateTime @db.Date
  text String

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([taskId])
}

// ---------------------------------------------------------------------
// Marketing (2026-10-08, from Craig's mockup) — each artist's own
// mailing list, kept entirely separate from Customer (a buyer is not
// automatically a subscriber; one can be added from Customers, with
// consent). Edited under the site's Marketing → Subscribers.
// ---------------------------------------------------------------------

// One person on an artist's mailing list. `email` is stored trimmed and
// lowercased and is unique per artist, which is what stops a duplicate
// and what an import matches against: anyone already on file — whether
// Subscribed or Unsubscribed — keeps their details and status untouched.
// `consentAt` is when they agreed to receive mail (confirmed by whoever
// added them). `language` is "EN" or "FR", or null for the artist's own
// default, same as Customer.language. `customerId` links a subscriber
// added from Customers; cleared, not the subscriber deleted, if that
// customer is deleted.
model Subscriber {
  id       String @id @default(cuid())
  artistId String
  artist   Artist @relation(fields: [artistId], references: [id])

  email     String
  firstName String?
  lastName  String?
  language  String?

  status         SubscriberStatus @default(SUBSCRIBED)
  source         SubscriberSource
  consentAt      DateTime?
  unsubscribedAt DateTime?

  // The secret in this subscriber's unsubscribe link (2026-10-08) —
  // news.jevca.art/unsubscribe/<token>, in every campaign mail and its
  // one-click List-Unsubscribe header. Random and unguessable, so the
  // link can't be used to unsubscribe anyone else.
  unsubscribeToken String @unique @default(dbgenerated("replace(gen_random_uuid()::text, '-', '') || replace(gen_random_uuid()::text, '-', '')"))

  customerId String?
  customer   Customer? @relation(fields: [customerId], references: [id], onDelete: SetNull)

  lists MailListMember[]

  // The campaign mails sent (or to be sent) to this subscriber.
  campaignRecipients CampaignRecipient[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([artistId, email])
  @@index([artistId, status])
  @@index([customerId])
}

// A named group of an artist's subscribers (2026-10-08) — e.g.
// "Collectors". A subscriber can be in any number of lists; deleting a
// list never deletes its subscribers.
model MailList {
  id       String @id @default(cuid())
  artistId String
  artist   Artist @relation(fields: [artistId], references: [id])

  name String

  members MailListMember[]

  // The campaigns sent (or to be sent) to this list.
  campaigns CampaignList[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([artistId, name])
  @@index([artistId])
}

// One subscriber's place in one mail list (2026-10-08). Removed with
// either.
model MailListMember {
  listId       String
  list         MailList   @relation(fields: [listId], references: [id], onDelete: Cascade)
  subscriberId String
  subscriber   Subscriber @relation(fields: [subscriberId], references: [id], onDelete: Cascade)

  addedAt DateTime @default(now())

  @@id([listId, subscriberId])
  @@index([subscriberId])
}

model Site {
  id                   String     @id @default(cuid())
  name                 String
  domain               String?
  status               SiteStatus @default(DRAFT)
  multiLanguageEnabled Boolean    @default(false)
  salesEnabled         Boolean    @default(false)
  defaultCurrency      String     @default("GBP")
  domainStatus         String?
  domainRenewalDate    DateTime?
  artistId             String
  artist               Artist     @relation(fields: [artistId], references: [id])
  createdAt            DateTime   @default(now())
  updatedAt            DateTime   @updatedAt
  // When the site was last opened in the admin (2026-10-07) — drives the
  // recent sites under "Sites" in the main menu. Null = never opened.
  lastVisitedAt        DateTime?

  pages Page[]
  // The site as last published (2026-10-06) — see SitePublication.
  publication SitePublication?

  // The site's menu (2026-10-06) — a Menu Style, chosen under Live
  // Pages on the Pages page. Every page uses it unless it has its own
  // (Page.menuStyleId). Optional; cleared, not the site changed, if the
  // style is deleted.
  menuStyleId String?
  menuStyle   MenuStyle? @relation(fields: [menuStyleId], references: [id], onDelete: SetNull)

  // Marketing → Mail Campaigns (2026-10-08). See Campaign below.
  campaigns Campaign[]

  @@index([artistId])
  @@index([menuStyleId])
  @@index([lastVisitedAt])
}

// A site as last published (2026-10-06) — a snapshot of everything its
// pages show (its Live Pages in order, their Display Styles, curations,
// sections, canvas layouts and each work's presentation), saved by
// "Publish to live site". The site's pages are drawn only from this, so
// later edits don't show until the next publish. `data` is a
// SiteSnapshot — see lib/siteSnapshot.ts. Removed with its site.
model SitePublication {
  siteId String @id
  site   Site   @relation(fields: [siteId], references: [id], onDelete: Cascade)

  data        Json
  publishedAt DateTime @default(now())
}

model Page {
  id        String   @id @default(cuid())
  siteId    String
  site      Site     @relation(fields: [siteId], references: [id])
  title     String
  slug      String
  visible   Boolean  @default(true)
  position  Int      @default(0)

  // The curation this page shows (2026-10-04) — optional; one per page.
  // Must be one of the site's own artist's curations (checked in
  // lib/actions/pages.ts). Cleared, not the page deleted, if the
  // curation is deleted. Not used by a page with a Canvas style, which
  // has its own placed curations instead (canvasItems below).
  curationId String?
  curation   Curation? @relation(fields: [curationId], references: [id], onDelete: SetNull)

  // The Page Style this page is displayed with (2026-10-04) — chosen as
  // "Display Style" on the Pages page. Optional; cleared, not the page
  // deleted, if the style is deleted.
  pageStyleId String?
  pageStyle   PageStyle? @relation(fields: [pageStyleId], references: [id], onDelete: SetNull)

  // This page's own menu (2026-10-06), in place of the site's
  // (Site.menuStyleId) — null = the site's. Chosen as "Menu" in the
  // page's Edit on the Pages page; cleared if the style is deleted.
  menuStyleId String?
  menuStyle   MenuStyle? @relation(fields: [menuStyleId], references: [id], onDelete: SetNull)

  // The curations placed on this page's canvas (2026-10-05) — used when
  // its Display Style is a Canvas. See PageCanvasItem.
  canvasItems PageCanvasItem[]

  // What fills this page's components (2026-10-07) — used when its
  // Display Style is a Block Build. See PageComponentContent.
  componentContents PageComponentContent[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([siteId, slug])
  @@index([siteId])
  @@index([curationId])
  @@index([pageStyleId])
  @@index([menuStyleId])
}

// One curation placed on a Canvas page (2026-10-05) — its tile's
// top-left corner at (x, y), in canvas pixels from the canvas's
// top-left. Placed by dragging in the page's Arrange canvas editor; the
// canvas is as big as the placements need. A curation appears at most
// once per page, and must be the site's own artist's (checked in
// lib/actions/pageCanvas.ts). Removed with its page or curation.
model PageCanvasItem {
  id         String   @id @default(cuid())
  pageId     String
  page       Page     @relation(fields: [pageId], references: [id], onDelete: Cascade)
  curationId String
  curation   Curation @relation(fields: [curationId], references: [id], onDelete: Cascade)

  x Int
  y Int

  @@unique([pageId, curationId])
  @@index([curationId])
}

// What fills one component of a Block Build page (2026-10-07, from
// Craig's mockup): one of the page's curation's sections, dragged onto
// it in the page's Arrange, or — `sectionId` null — the curation's
// works. One per component. `blockId` is the component's id in the
// page's Display Style (PageStyle.layout, JSON), so it isn't a foreign
// key: a row for a component later removed from the style is never
// shown. Removed with its page or its section; cleared when the page's
// Display Style changes, and its sections when the page's curation
// changes (see updatePageDetails in lib/actions/pages.ts). See
// lib/pageComponents.ts.
model PageComponentContent {
  id        String           @id @default(cuid())
  pageId    String
  page      Page             @relation(fields: [pageId], references: [id], onDelete: Cascade)
  blockId   String
  sectionId String?
  section   CurationSection? @relation(fields: [sectionId], references: [id], onDelete: Cascade)

  @@unique([pageId, blockId])
  @@index([sectionId])
}

// A Page Style (2026-10-04) — a named page layout, shared by every site,
// managed under Templates → Page Styles. `type` is its Style Type
// (BLOCK_BUILD or CANVAS — see PageStyleType); `layout` is that type's
// arrangement and settings, with no content in it, saved as JSON (see
// lib/pageStyleLayout.ts).
model PageStyle {
  id   String        @id @default(cuid())
  name String        @unique
  type PageStyleType

  layout Json @default("{}")

  // Pages displayed with this style — see Page.pageStyleId.
  pages Page[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

// A Mail Template (2026-10-08, Marketing step 2) — a named starting
// layout for a campaign's mails, shared by every site and managed under
// Templates → Mail Templates, like Page Styles. Layout and look only,
// no content: `layout` holds its components, rows, spacing, colours and
// text look as JSON (see lib/mailTemplateLayout.ts). A mail copies it
// and can then change it.
model MailTemplate {
  id   String @id @default(cuid())
  name String @unique

  layout Json @default("{}")

  // The campaign mails started from this template (kept if it's deleted).
  campaignMails CampaignMail[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

// A Menu Style (2026-10-06, from Craig's request) — a named site menu
// design, shared by every site, managed under Templates → Menus. It sets
// how the menu looks and behaves only: the menu's items and their order
// are always the site's Live Pages. `layout` holds the settings as JSON
// (see lib/menuStyleLayout.ts). Chosen per site, and optionally per page
// (2026-10-06) — see Site.menuStyleId and Page.menuStyleId.
model MenuStyle {
  id   String @id @default(cuid())
  name String @unique

  layout Json @default("{}")

  sites Site[]
  pages Page[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Artwork {
  id       String @id @default(cuid())
  artistId String
  artist   Artist @relation(fields: [artistId], references: [id])

  catalogueNumber String

  // Mirrors Catalogue's `offeredPrice` (2026-08-28) — Presentation no
  // longer has its own independently-typed price; "Price" there is a
  // read-only display of this same figure, kept in sync from
  // updateCatalogue every time Offered price is saved. Stays a real
  // column (not computed on read) since Payment/Sale Terms/invoices
  // already depend on it — re-plumbing every one of those to read a
  // different field directly was a bigger, riskier change than just
  // keeping this in sync underneath.
  presentationPrice Decimal?            @db.Decimal(10, 2)
  // Deprecated (2026-08-16) — superseded by `size` (Size and Dimensions
  // turned out to be the same concept; `size` already holds real
  // dimension-like values via the artist's own preset list). Column
  // kept, not dropped, only because older CSV-imported rows may still
  // have data here — nothing in the app reads or writes it any more.
  dimensions        String?
  description       String?
  medium            String?
  // Presentation's own, independently-editable Medium wording
  // (2026-08-28) — seeded once from Catalogue's `medium` the first time
  // Catalogue's Medium is set, then edited separately from here on.
  presentationMedium String?
  // "Can be viewed at" (2026-08-28) — e.g. a gallery or platform name,
  // shown on Presentation only.
  viewingLocation    String?
  availability      ArtworkAvailability @default(AVAILABLE)
  visible           Boolean             @default(true)

  // The artwork's one and only name (2026-09-24) — used everywhere the
  // artwork is named: catalogue, website, sales, invoices, receipts,
  // certificates and Stripe. Replaces the old separate Presentation
  // title, which was dropped.
  catalogueName  String
  // Free text (e.g. "June 2025"), not a real calendar date or a bare
  // year — renamed + retyped from the old numeric `year` (2026-09-07,
  // direct request, alongside unifying the Catalogue/Hopper forms) since
  // artists write this loosely and a plain Int couldn't hold that.
  date           String?
  type           String?
  size           String?
  // Free text, matched by exact name against Location.name
  // (2026-09-22) — not a foreign key; see the note on Location above
  // for why. Kept this way (rather than a locationId column) so this
  // migration touches nothing else about how Artwork is read or written
  // anywhere in the app — only which names the dropdown offers, and
  // what pressing "Sold" now does with the chosen name, changed.
  location       String?
  edition        String?
  availableQty   Int?
  // Deprecated (2026-08-15) — Catalogue no longer holds price at all
  // (moved to Presentation's `presentationPrice`, the Unframed price).
  // Column kept, not dropped, for the same reason as `dimensions` above.
  priceUnframed  Decimal? @db.Decimal(10, 2)
  // Deprecated (2026-08-28) — the Framed/Unframed dual-price mechanic is
  // gone: each Catalogue entry is a single sellable listing with one
  // price now (`offeredPrice`). If a piece genuinely exists both framed
  // and unframed, that's two separate Catalogue entries (via "Create
  // Derivative"), not two prices on one. Column kept, not dropped, for
  // the same reason as `priceUnframed`/`dimensions` above.
  priceFramed    Decimal? @db.Decimal(10, 2)
  // Manually entered on Catalogue (2026-08-28) — the actual asking
  // price. Mirrored into `presentationPrice` on every save (see the
  // note there) so the rest of the app (Payment, invoices, Sale Terms)
  // keeps working unchanged.
  offeredPrice   Decimal? @db.Decimal(10, 2)
  // The currency of offeredPrice (2026-09-26) — "GBP" or "EUR" (see
  // lib/currencies.ts). A new artwork starts in its artist's default
  // currency (getArtistDefaultCurrency, lib/primarySite.ts). While the
  // artwork's Location is a GALLERY, offeredPrice is the price agreed
  // with that gallery and the Catalogue labels it "Consigned price";
  // it is still this one field, so a work never carries two prices.
  priceCurrency  String   @default("GBP")
  studioNotes    String?

  // True only for artworks created via the Hopper's "Add New Artwork"
  // button (2026-08-17) — never for the ordinary "+ New" in the Artwork
  // Catalogue itself, and never for quick-creating an artwork from other
  // pickers elsewhere (e.g. Related Images), even though those also call
  // the same underlying quickCreateArtwork(). Cleared the first time
  // the Catalogue is actually saved — see updateCatalogue. Powers the
  // "raw import, not yet reviewed" count shown next to Artwork
  // Catalogue in the nav.
  needsReview Boolean @default(false)

  images Image[]

  mainImageId String? @unique
  // onDelete: Restrict (2026-09-12 fix) — was left at Prisma/Postgres's
  // default action for an optional FK, which is SetNull, not Restrict.
  // deleteImagePermanently (lib/actions/imageDelete.ts) already has a
  // catch block that assumes deleting a still-referenced main image
  // fails with a friendly "remove that link first" error — that
  // assumption was simply wrong: the delete was silently succeeding and
  // quietly nulling out mainImageId instead, which is what let deleting
  // a Related image in the Media Catalogue also silently wipe out that
  // same artwork's main image (reported 2026-09-12). This makes the
  // relation actually behave the way the error-handling code already
  // expected.
  mainImage   Image?  @relation("ArtworkMainImage", fields: [mainImageId], references: [id], onDelete: Restrict)

  // Which artwork (if any) this one was created as a "Create Derivative"
  // copy of (2026-09-11) — shown in the Catalogue tab's header as
  // "Derived from #...". Nullable: most artworks aren't derivatives.
  // onDelete: SetNull so deleting the original artwork a derivative was
  // copied from never cascades into deleting the derivative itself — it
  // just loses this back-reference. `derivatives` (the reverse list) is
  // unused for now but kept for completeness/future use (e.g. showing
  // every derivative of a given artwork).
  derivedFromId String?
  derivedFrom   Artwork?  @relation("ArtworkDerivative", fields: [derivedFromId], references: [id], onDelete: SetNull)
  derivatives   Artwork[] @relation("ArtworkDerivative")

  saleTerms SaleTerms?
  purchases Purchase[]
  // Every Curation this artwork is in (2026-09-24) — see CurationItem.
  curationItems CurationItem[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([artistId, catalogueNumber])
  @@index([artistId])
  @@index([derivedFromId])
}

model SaleTerms {
  id        String  @id @default(cuid())
  artworkId String  @unique
  artwork   Artwork @relation(fields: [artworkId], references: [id])

  totalAmount Decimal @db.Decimal(10, 2)
  currency    String  @default("GBP")

  instalmentCount Int @default(5)

  // No longer typed per-artwork on Presentation (2026-08-28) — every
  // save of this row now takes the artist's current Settings → Payment
  // Defaults values fresh, rather than an independently-editable
  // override, so changing the Settings default reaches every artwork
  // automatically. Columns kept (not dropped) since Purchase still
  // snapshots them at sale time, and a specific active sale can still
  // have its own message edited afterwards (PurchasePanel's "Release
  // message for this sale" — a different, already-started-sale-specific
  // feature, left as is).
  releaseMessage      String?
  releaseTriggerCount Int?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Purchase {
  id        String  @id @default(cuid())
  artworkId String
  artwork   Artwork @relation(fields: [artworkId], references: [id])

  status PurchaseStatus @default(ACTIVE)
  channel SaleChannel @default(STRIPE)

  buyerName    String?
  buyerEmail   String?
  buyerAddress String?

  // Added 2026-08-13, alongside the snapshot fields above rather than
  // replacing them — buyerName/buyerEmail/buyerAddress stay exactly as
  // they were captured at the time of sale (so past invoices/receipts
  // never change), while this link enables "list this customer's sales"
  // and lets a customer's own language preference override the artist's
  // default. Nullable so every sale made before Customer records existed
  // needs no backfill or migration.
  customerId String?
  customer   Customer? @relation(fields: [customerId], references: [id])

  type PurchaseType

  // Deprecated (2026-08-28) — the Framed/Unframed choice at point of
  // sale is gone, alongside Artwork.priceFramed (see the note there).
  // Column kept, not dropped, since existing sale history still uses it
  // for its own "(Framed)" label — never set true for a new sale going
  // forward.
  framed Boolean @default(false)

  source String?

  commissionPercent Decimal? @db.Decimal(5, 2)

  // A framing or delivery charge arranged AFTER the artwork's sale was
  // paid (2026-09-23) is its own separate sale — its own invoice,
  // payments and receipt — linked back to the sale it belongs to, and
  // titled "[artwork] Framing Charge" / "... Delivery Charge" (see
  // saleTitle(), lib/saleMath.ts). At most one of each kind per sale.
  // Never gets a Certificate of Authenticity. Deleting the parent sale
  // deletes its charges too.
  parentPurchaseId String?
  parentPurchase   Purchase?   @relation("PurchaseCharges", fields: [parentPurchaseId], references: [id], onDelete: Cascade)
  charges          Purchase[]  @relation("PurchaseCharges")
  chargeKind       ChargeKind?

  // Money already collected at the moment the sale was recorded
  // (2026-09-22, Phase 1 sale-recording rework) — only ever set for an
  // OWN-location sale (a deposit collected on the spot from the actual
  // buyer; a Gallery sale uses commissionPercent instead, since that's a
  // cut owed by the gallery, not money already in hand). Reduces what's
  // still owed (Net Due) the moment the sale is recorded, alongside
  // commissionPercent — both are subtracted unconditionally by the one
  // shared netOwed() formula (lib/saleMath.ts) rather than the caller
  // needing to know which of the two actually applies.
  depositPaid Decimal? @db.Decimal(10, 2)

  // Framing and delivery arranged for this sale (2026-09-23) — at most
  // one of each; editing replaces it. Both costs are paid by the buyer/
  // gallery, so they ADD to Net Due, and commission is never charged on
  // them (sale price only). See saleBreakdown(), lib/saleMath.ts.
  framer       String?
  framingCost  Decimal? @db.Decimal(10, 2)
  courier      String?
  deliveryCost Decimal? @db.Decimal(10, 2)

  invoiceNumber Int?

  // Persistent Payment Link (not a one-off Checkout Session — see the
  // note on createGalleryPaymentLink in payments.ts) for the net amount
  // a gallery owes on this sale. Only ever set for GALLERY-channel
  // sales (2026-09-01, Part Three).
  stripePaymentLinkId  String?
  stripePaymentLinkUrl String?

  // The instalment-plan counterpart of the link above (2026-09-23): a
  // Payment Link for the FIRST of stripeInstalmentLinkCount instalments
  // of the balance, saving the buyer's card so the rest are charged
  // monthly (see recordGalleryStripePayment). Both links are retired
  // whenever the balance changes, since each encodes a fixed amount.
  stripeInstalmentLinkId    String?
  stripeInstalmentLinkUrl   String?
  stripeInstalmentLinkCount Int?

  // When the invoice for this sale was last actually emailed, and to
  // which address — set only by sendInvoiceEmail
  // (lib/actions/invoiceEmail.ts, 2026-09-01, Part Three). Purely a log
  // for display; re-sending overwrites both rather than keeping history.
  invoiceEmailedAt DateTime?
  invoiceEmailedTo String?

  // The same log for the receipt (2026-09-23) — kept separate so the
  // sale shows both "Invoice sent" and "Receipt sent". Set by
  // sendInvoiceEmail when the sale is already paid.
  receiptEmailedAt DateTime?
  receiptEmailedTo String?

  // Same simple sent-log, for the Certificate of Authenticity
  // (2026-09-03) — see the matching invoiceEmailedAt/invoiceEmailedTo
  // above. Independent of those: a sale can have its invoice/receipt
  // sent without ever having a certificate requested, or vice versa.
  certificateEmailedAt DateTime?
  certificateEmailedTo String?

  totalAmount         Decimal @db.Decimal(10, 2)
  currency            String
  instalmentCount     Int?
  releaseMessage      String?
  releaseTriggerCount Int?

  // Which Stripe account this sale's money goes to (2026-09-25, Stripe
  // Connect) — fixed when the sale is created, from the artist's own
  // mode and linked account at that moment (see StripeConnection), and
  // never changed afterwards. Every Stripe object for the sale (customer,
  // payment links, card payments, instalment schedule) lives in that one
  // account, so an instalment plan keeps charging the account it started
  // on even if the artist later links or unlinks a Stripe account.
  // stripeAccountId null means Jetenvoieca's own account.
  stripeMode      StripeMode
  stripeAccountId String?

  stripeCustomerId              String?
  stripeCheckoutSessionId       String?
  stripeSubscriptionScheduleId  String?
  stripeSubscriptionId          String?

  payments Payment[]
  // Every invoice/receipt/certificate email ever sent for this sale
  // (2026-09-05, Email Integration — unified Sent list). Purely additive
  // alongside invoiceEmailedAt/certificateEmailedAt above, which remain
  // the source for the per-sale "Invoice sent [date]" line.
  outboundEmails OutboundEmail[]
  // Alerts raised about this sale (2026-09-21) — see AlertEvent.purchaseId.
  alertEvents AlertEvent[]

  createdAt DateTime  @default(now())
  closedAt DateTime?

  @@index([artworkId])
  @@index([customerId])
  @@index([parentPurchaseId])
  @@index([stripeAccountId])
}

model Payment {
  id         String   @id @default(cuid())
  purchaseId String
  purchase   Purchase @relation(fields: [purchaseId], references: [id], onDelete: Cascade)

  sequence Int
  amount   Decimal       @db.Decimal(10, 2)
  currency String
  status   PaymentStatus @default(DUE)

  dueDate  DateTime?
  paidDate DateTime?

  // Only ever set on a GALLERY-channel sale's payment, by
  // recordGalleryPayment (2026-09-03) — chosen from Artist.paymentMethods
  // at the moment it's marked paid. Left null for Stripe-channel
  // payments (always card, not worth recording) and for every row
  // created before this existed.
  method String?

  stripePaymentIntentId String?
  stripeInvoiceId       String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([purchaseId])
}

model Image {
  id       String @id @default(cuid())
  artistId String
  artist   Artist @relation(fields: [artistId], references: [id])
  key       String
  url       String
  // Smaller derived versions of the original, generated at upload time
  // (2026-08-13 — see decisions log). Only ever set for PHOTO images;
  // videos keep using posterUrl as before. Nullable because existing
  // images uploaded before this change need a one-off backfill — until
  // that runs (or for any image where it fails), every place that reads
  // these falls back to the original `url`, so nothing breaks in the
  // meantime, it's just not sped up yet.
  thumbnailKey String?
  displayKey   String?
  posterUrl String?
  kind      ImageKind   @default(PHOTO)
  mimeType  String
  caption   String?
  // Longer free-text note, separate from Caption — added 2026-09-02
  // alongside the iPhone Shortcut's "Name and Description" fields (see
  // hopper-shortcut-design notes). Caption already served as the
  // Hopper's "Name" (and becomes a new artwork's title on "Add
  // Artwork"); this is its new companion field, editable from the same
  // Hopper sorting card and carried into a new artwork's own
  // `description` the same way Caption is carried into its title.
  description String?
  // Details captured alongside the photo by the artist's own capture app
  // (Studio, 2026-09-21; Location added 2026-09-26) — what this image is
  // going to become. They fill in the Hopper's "Create new artwork" form
  // (QuickCatalogueFields in HopperView.tsx), so they carry into the new
  // artwork's Size / Offered price / Type / Location. Named artwork* so
  // they can't be mistaken for anything about the image file itself.
  // Size, type and location are free text, matched by name against the
  // artist's own lists (same convention as Artwork.size / Artwork.type /
  // Artwork.location); price is money, so Decimal like
  // Artwork.offeredPrice. All optional — null for every image not sent
  // from Studio, or sent without details.
  artworkSize     String?
  artworkPrice    Decimal? @db.Decimal(10, 2)
  artworkType     String?
  artworkLocation String?
  altText   String?
  tags      String[]    @default([])
  status    ImageStatus @default(SORTED)
  source    String?
  // True only when this image was just routed from the Hopper into the
  // Media Catalogue (addHopperItemToMedia, 2026-08-17) — not for images
  // uploaded directly to the Media Catalogue by other means. Cleared the
  // first time it's actually saved from the Media detail panel — see
  // updateMedia. Powers the "raw import, not yet reviewed" count shown
  // next to Media Catalogue in the nav. Deliberately not set when a
  // Hopper item is instead linked to an artwork (addHopperItemToArtwork)
  // — that's an existing, already-described artwork gaining one more
  // image, not a new, undescribed catalogue entry needing review.
  needsReview Boolean @default(false)
  artworkId String?
  artwork   Artwork?    @relation(fields: [artworkId], references: [id])

  mainImageOfArtwork Artwork? @relation("ArtworkMainImage")
  profileImageOfArtist Artist? @relation("ArtistProfileImage")
  // Curations using this image in a work's own image set (2026-10-03) —
  // see CurationItemImage.
  curationItemImages CurationItemImage[]
  // Curation sections showing this image or video (2026-10-06) — see
  // CurationSectionMedia.
  curationSectionMedia CurationSectionMedia[]

  sourceVideoRender VideoRender?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([artistId])
  @@index([artworkId])
}

enum VideoRenderStatus {
  DRAFT
  PENDING
  RENDERING
  DONE
  FAILED
}

// Tracks one video, from first being assembled in the Video Editor through
// to a finished Shotstack render. See bucket-video-editor-design.md.
model VideoRender {
  id       String @id @default(cuid())
  artistId String
  artist   Artist @relation(fields: [artistId], references: [id])

  name String?

  status           VideoRenderStatus @default(DRAFT)
  shotstackRenderId String?
  renderEnv         String?
  renderError       String?
  // The exact JSON submitted to Shotstack for this render, saved every
  // time regardless of success or failure — a self-contained diagnostic
  // record so the actual request can be inspected directly in the app
  // (not chased down in Netlify's function logs) if a render looks wrong.
  // Temporary/debugging-oriented; not part of the core design.
  debugPayload      Json?
  // R2 object keys for the temporary re-encoded photo assets uploaded
  // for this specific render (see prepareImageAsset in render.ts).
  // Recorded so they can be deleted once Shotstack has actually fetched
  // them — they're single-use and otherwise leak in storage forever.
  // Cleaned up by the webhook once the render reaches DONE or FAILED.
  tempAssetKeys     String[] @default([])

  timeline Json?

  resultImageId String? @unique
  // onDelete: Restrict (2026-09-12 fix) — same issue and fix as
  // Artwork.mainImage above: this was silently defaulting to SetNull on
  // an Image delete instead of actually blocking it.
  resultImage   Image?  @relation(fields: [resultImageId], references: [id], onDelete: Restrict)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([artistId])
}

// Manual record of what the artist spends — an embryonic accounts
// feature (2026-08-27 decision), deliberately independent of Pennylane:
// API-based auto-population from Pennylane's supplier invoices was
// designed (see e-invoicing-design.md) but is blocked behind a paid
// Pennylane plan, so this exists as simple manual entry instead, and can
// be extended rather than replaced if that's ever unblocked.
//
// Named `Expense`, not `Purchase` — `Purchase` already means an
// artwork sale to a buyer elsewhere in this schema; reusing the word
// here for the opposite direction (money going out, not coming in)
// would be actively confusing.
model Expense {
  id       String @id @default(cuid())
  artistId String
  artist   Artist @relation(fields: [artistId], references: [id])

  date        DateTime
  payeeName   String
  description String?
  amount      Decimal @db.Decimal(10, 2)
  currency    String  @default("GBP")
  category    String  @default("Other")

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([artistId])
  @@index([date])
}

// The platform owner's own business expenses (Namecheap, Netlify, etc.)
// — deliberately separate from Expense above, which is an artist's own
// spending. This one isn't tied to any Artist at all; it sits against
// the platform's own subscription revenue on the Accounts page
// (2026-08-27 decision).
model PlatformExpense {
  id String @id @default(cuid())

  date        DateTime
  payeeName   String
  description String?
  amount      Decimal @db.Decimal(10, 2)
  currency    String  @default("GBP")
  category    String  @default("Other")

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([date])
}

// Single-row config table for platform-wide settings — there's no
// existing "Platform" model to hang this off (everything else is
// Artist- or Site-scoped), so this exists purely to hold the editable
// category list for PlatformExpense above, the same way Artist holds
// expenseCategories for its own. Always read/written via the fixed id
// "singleton" — see src/lib/actions/platformExpenseSettings.ts.
model PlatformSettings {
  id String @id @default("singleton")

  expenseCategories String[] @default(["Hosting", "Domains", "Software & APIs", "Legal & Accounting", "Marketing", "Other"])

  // Settings-editable list offered as the Category dropdown on the
  // Inbox's task form (2026-09-19, CRM Phase 2) — same pattern as
  // expenseCategories above, but starts empty: the categories are
  // entirely Craig's own to define. See Task.category.
  taskCategories String[] @default([])

  // The address ad hoc admin emails are sent from (2026-09-05, Email
  // Integration) — one shared address, not per-artist: these are
  // Craig's own emails to artists/contacts, not sent on any artist's
  // behalf (direct decision — "craig@jevca.art is more friendly").
  // Editable here rather than an env var, so it doesn't need a redeploy
  // to change, consistent with everything else on this singleton row.
  // Used by the Inbox's Art mailbox.
  adminEmailAddress String @default("craig@jevca.art")

  // The same, for the Inbox's Business mailbox (2026-09-27) — the
  // address new Business messages are sent from.
  businessEmailAddress String @default("craig@jetenvoieca.com")

  updatedAt DateTime @updatedAt
}

// Step-by-step user guides, shown in the Administration menu (2026-09-04,
// direct request) — platform-wide like PlatformExpense above, not tied
// to any Artist or Site: this is the platform owner's own internal
// documentation, managed centrally in one place rather than per site.
//
// `steps` is an ordered JSON array (`{ id, text, imageUrl }[]`) rather
// than a child table, since steps are only ever read/written as one
// whole unit from the guide's own edit panel, never queried on their
// own.
model Guide {
  id       String        @id @default(cuid())
  category GuideCategory
  title    String

  steps Json @default("[]")

  // Sets display order within its category — a new guide is appended
  // after the current highest position in that category. No drag-and-
  // drop between categories; a guide's category is fixed once created.
  position Int @default(0)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([category])
}

// ---------------------------------------------------------------------
// The business's own website, jetenvoieca.com (2026-09-29, direct
// request). Platform-level like Guide above — deliberately NOT built on
// Site/Page (the artist site builder), which belong to an Artist: this
// is the business's site, not a client's. Edited from Administration →
// Website. Edits go live on save — no draft/publish (direct decision).
// ---------------------------------------------------------------------

// The one Home page — always id "singleton", same pattern as
// PlatformSettings. imageUrl is a direct upload (like Artist.logoUrl),
// not an Image row: Image belongs to an Artist's Media Catalogue.
// `email` is also what the Contact page shows (one address, one place).
model WebsiteHome {
  id String @id @default("singleton")

  imageUrl String?
  wordmark String  @default("JETENVOIECA")
  email    String?

  updatedAt DateTime @updatedAt
}

// CONTENT = an ordinary content page. CONTACT = the one fixed Contact
// page (2026-09-29): same fields, plus WebsiteHome.email shown as a
// link, and it can't be deleted. Created by migration, never by the
// editor.
enum WebsitePageKind {
  CONTENT
  CONTACT
}

// A content page — e.g. "Artists". `name` is what the editor's page
// dropdown shows; `slug` is its web address (jetenvoieca.com/<slug>),
// set from the name and editable. title/caption/text are what the page
// shows: small orange label, large serif heading, body text.
model WebsitePage {
  id   String          @id @default(cuid())
  kind WebsitePageKind @default(CONTENT)
  name String
  slug String          @unique

  title   String @default("")
  caption String @default("")
  text    String @default("")

  position Int @default(0)

  menuItems WebsiteMenuItem[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([position])
}

// One item in the Home page's menu — e.g. label "ARTISTS", text
// "Websites for Artists", hoverText shown beneath it on mouseover, and
// the content page it links to. Its own text, not read from the linked
// page (direct decision — menu wording is usually an abbreviated form).
// pageId is cleared, not the item deleted, if that page is deleted.
model WebsiteMenuItem {
  id String @id @default(cuid())

  label     String @default("")
  text      String @default("")
  hoverText String @default("")

  pageId String?
  page   WebsitePage? @relation(fields: [pageId], references: [id], onDelete: SetNull)

  position Int @default(0)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([position])
  @@index([pageId])
}

// A mail campaign (2026-10-08, Marketing step 3) — made on a site's
// Marketing → Mail Campaigns page, sent to that artist's subscribers.
// Belongs to the site (not just the artist) so its mails link to that
// site's website. Its mails are in CampaignMail. Names are unique within
// a site, so the list stays readable.
model Campaign {
  id     String @id @default(cuid())
  siteId String
  site   Site   @relation(fields: [siteId], references: [id])
  name   String

  mails CampaignMail[]

  // Sending (2026-10-08): DRAFT until Send now / Send at, SCHEDULED
  // until `scheduledAt` (Paris time chosen, stored in UTC), SENDING while
  // the batches go out (see lib/campaignSending.ts), then SENT. Once
  // sending starts, the principal and alternative mails can't change.
  // `sendError`: why a scheduled campaign couldn't start (it goes back to
  // DRAFT).
  status      CampaignStatus @default(DRAFT)
  scheduledAt DateTime?
  startedAt   DateTime?
  sentAt      DateTime?
  sendError   String?

  // The mail lists it goes to (anyone on several gets one copy).
  lists      CampaignList[]
  recipients CampaignRecipient[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([siteId, name])
  @@index([status, scheduledAt])
}

enum CampaignStatus {
  DRAFT
  SCHEDULED
  SENDING
  SENT
}

// A mail list a campaign goes to (2026-10-08).
model CampaignList {
  campaignId String
  campaign   Campaign @relation(fields: [campaignId], references: [id], onDelete: Cascade)
  listId     String
  list       MailList @relation(fields: [listId], references: [id], onDelete: Cascade)

  @@id([campaignId, listId])
  @@index([listId])
}

// One person a campaign goes to (2026-10-08), made when sending starts:
// which of the campaign's mails they get (by the mails' shares), in
// which language, and how it went. SKIPPED: unsubscribed before their
// turn, or French with no French subject on their mail. `claimedAt`:
// taken by a sending run, so two runs never send the same person.
// `resendEmailId` matches Resend's events back to them.
// Tracking (2026-10-09), from Resend's webhook (see lib/campaignTracking.ts):
// the first time each thing happened. A click counts as an open too
// (images may be blocked). `bounceType`: Resend's own (Permanent =
// hard bounce; the reason goes in `error`).
model CampaignRecipient {
  id           String       @id @default(cuid())
  campaignId   String
  campaign     Campaign     @relation(fields: [campaignId], references: [id], onDelete: Cascade)
  mailId       String
  mail         CampaignMail @relation(fields: [mailId], references: [id], onDelete: Cascade)
  subscriberId String?
  subscriber   Subscriber?  @relation(fields: [subscriberId], references: [id], onDelete: SetNull)

  email    String
  language String

  status        CampaignRecipientStatus @default(PENDING)
  resendEmailId String?
  error         String?
  claimedAt     DateTime?
  sentAt        DateTime?

  deliveredAt  DateTime?
  openedAt     DateTime?
  clickedAt    DateTime?
  bouncedAt    DateTime?
  bounceType   String?
  complainedAt DateTime?

  createdAt DateTime @default(now())

  @@unique([campaignId, subscriberId])
  @@index([campaignId, status])
  @@index([mailId])
  @@index([subscriberId])
  @@index([resendEmailId])
}

enum CampaignRecipientStatus {
  PENDING
  SENT
  SKIPPED
  FAILED
}

// Which of a campaign's mails this is (2026-10-08): the principal mail,
// up to 2 alternatives (each recipient gets one of these three, by
// share), and at most one follow-up.
enum CampaignMailKind {
  PRINCIPAL
  ALTERNATIVE
  FOLLOW_UP
}

// Who a campaign's follow-up mail goes to, N days after the campaign.
enum FollowUpCondition {
  NOT_OPENED
  OPENED
  CLICKED
  NOT_CLICKED
}

// One mail of a campaign (2026-10-08). `layout` is a copy of the Mail
// Template it started from (lib/mailTemplateLayout.ts), which the mail
// can then change; `content` is what fills each component, in English
// and French (lib/mailContent.ts). Subject and preview text are per
// language; a mail with no French subject isn't sent to French
// subscribers (Craig's choice). `templateId` is the template it started
// from (or was last switched to). An alternative has its `position` (1
// or 2) and `sharePercent` of the audience — the principal mail gets
// the rest. The follow-up has its condition and days.
model CampaignMail {
  id         String           @id @default(cuid())
  campaignId String
  campaign   Campaign         @relation(fields: [campaignId], references: [id], onDelete: Cascade)
  kind       CampaignMailKind @default(PRINCIPAL)
  templateId String?
  template   MailTemplate?    @relation(fields: [templateId], references: [id], onDelete: SetNull)
  position   Int              @default(0)

  sharePercent      Int?
  followUpCondition FollowUpCondition?
  followUpDays      Int?

  layout  Json @default("{}")
  content Json @default("{}")

  recipients CampaignRecipient[]

  subjectEn String?
  subjectFr String?
  previewEn String?
  previewFr String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([campaignId])
  @@index([templateId])
}
